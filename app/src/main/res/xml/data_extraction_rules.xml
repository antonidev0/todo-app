<?xml version="1.0" encoding="utf-8"?>
<!-- Copias de seguridad y paso a otro móvil (Android 12+). La clave del asistente no sale del móvil. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="asistente.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="asistente.xml" />
    </device-transfer>
</data-extraction-rules>
